# Art history backend — one pm2 process (127.0.0.1:3004), two hostnames.
# Repo: github.com/piosteiner/art_history (backend/). Documented in server-docs/CHANGELOG.md.

server {
    server_name api.arthistory.piogino.ch;

    client_max_body_size 1M;
    access_log /var/log/nginx/arthistory-api.access.log;
    error_log  /var/log/nginx/arthistory-api.error.log warn;

    location /v1/ {
        proxy_pass http://127.0.0.1:3004;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / { return 404; }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/api.arthistory.piogino.ch/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/api.arthistory.piogino.ch/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    server_name admin.arthistory.piogino.ch;

    client_max_body_size 10M;
    access_log /var/log/nginx/arthistory-admin.access.log;
    error_log  /var/log/nginx/arthistory-admin.error.log warn;

    # Compress what the app sends (gzip is on globally, but only for text/html and not for proxied responses).
    # The Markdown editor bundle shrinks from ~310 KB to ~100 KB.
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/css application/javascript text/javascript application/json;

    # No basic auth (removed 2026-09-29): the app's login is the only one. Failed logins (401 on POST /login in the
    # access log below) are banned by fail2ban, jail arthistory-admin (/etc/fail2ban/jail.d/arthistory.local).

    location / {
        proxy_pass http://127.0.0.1:3004;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/api.arthistory.piogino.ch/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/api.arthistory.piogino.ch/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}


server {
    if ($host = api.arthistory.piogino.ch) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name api.arthistory.piogino.ch;
    return 404; # managed by Certbot


}

server {
    if ($host = admin.arthistory.piogino.ch) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name admin.arthistory.piogino.ch;
    return 404; # managed by Certbot


}