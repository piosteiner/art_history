# Installed at /etc/systemd/system/arthistory-watch-lot.service (copy kept in server-docs/config/systemd/).
# Daily check of Sotheby's lot 10 (Blaquier-Arrieta sale) — see scripts/watch-lot.sh. Logs: journalctl -u arthistory-watch-lot
[Unit]
Description=Art history: watch Sotheby's lot 10 for a corrected provenance
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
ExecStart=/var/www/arthistory/scripts/watch-lot.sh
Nice=10
