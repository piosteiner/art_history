# Installed at /etc/systemd/system/arthistory-watch-lot.timer. Status: systemctl list-timers arthistory-watch-lot
# Until the sale (18 November 2026); the script disables the timer after that day.
[Unit]
Description=Daily check of Sotheby's lot 10 until the sale

[Timer]
OnCalendar=*-*-* 08:13:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
