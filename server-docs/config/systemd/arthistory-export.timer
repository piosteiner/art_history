# Installed at /etc/systemd/system/arthistory-export.timer. Status: systemctl list-timers arthistory-export
[Unit]
Description=Nightly art history content snapshot

[Timer]
# after the backup (03:30), so the two never compete for the database
OnCalendar=*-*-* 04:00:00 UTC
RandomizedDelaySec=10min
# Run at next boot if the server was off at 04:00
Persistent=true

[Install]
WantedBy=timers.target
