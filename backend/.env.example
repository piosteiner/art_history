# Template only. The real file lives OUTSIDE the repo:
#   ~/.config/arthistory/backend.env   (chmod 600)
# Non-secret settings (HOST, PORT, NODE_ENV) are set in ecosystem.config.js.

# Optional overrides
# CORS_ORIGIN=https://arthistory.piogino.ch
# API_HOST=api.arthistory.piogino.ch
# ADMIN_HOST=admin.arthistory.piogino.ch

# PostgreSQL role passwords — generated by backend/db/setup.sh, never typed by hand.
# Role names (arthistory_owner/_admin/_api) and DB_NAME are not secret: see config.js / ecosystem.config.js.
DB_OWNER_PASSWORD=<generated>
DB_ADMIN_PASSWORD=<generated>
DB_API_PASSWORD=<generated>


# Image search (src/admin/imagesearch.js): free API keys — without them the demo keys are used (rate-limited).
# Europeana: https://pro.europeana.eu/page/get-api · Smithsonian: https://api.data.gov/signup/
EUROPEANA_KEY=
SMITHSONIAN_KEY=
# DigitaltMuseum (Norway, Sweden): keys only for museums/organisations with an agreement (https://dok.digitaltmuseum.org/en/api);
# without one the source is not offered (its "demo" key is for testing only)
DIMU_KEY=
