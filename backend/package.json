{
  "name": "arthistory-api",
  "version": "0.1.0",
  "private": true,
  "description": "Art history API (/v1) and admin panel",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "npm run build:admin:dev && DB_NAME=arthistory_dev PORT=3005 node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:dev": "DB_NAME=arthistory_dev node scripts/migrate.js",
    "import": "node scripts/import.js",
    "import:dev": "DB_NAME=arthistory_dev node scripts/import.js",
    "test": "node --test 'test/*.test.js'",
    "export": "node scripts/export.js",
    "export:dev": "DB_NAME=arthistory_dev node scripts/export.js",
    "admin:user": "node scripts/admin-user.js",
    "admin:user:dev": "DB_NAME=arthistory_dev node scripts/admin-user.js",
    "build:admin": "esbuild src/admin/editor/editor.js src/admin/editor/map.js --bundle --minify --format=iife --target=es2020 --loader:.png=dataurl --loader:.svg=dataurl --outdir=src/admin/static",
    "build:admin:dev": "esbuild src/admin/editor/editor.js src/admin/editor/map.js --bundle --format=iife --target=es2020 --loader:.png=dataurl --loader:.svg=dataurl --sourcemap --outdir=src/admin/static-dev",
    "test:e2e": "playwright test",
    "boundaries": "node scripts/boundaries.js",
    "boundaries:dev": "DB_NAME=arthistory_dev node scripts/boundaries.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "diff": "^9.0.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "markdown-it": "^15.0.2",
    "pg": "^8.23.0",
    "sanitize-html": "^2.17.7",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@geoman-io/leaflet-geoman-free": "^2.20.2",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "leaflet": "^1.9.4",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12"
  }
}
