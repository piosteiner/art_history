# Editors: the style the frontend is written in (no formatter; long lines are fine where they keep one thought together).
# Line endings are left to git (stored as LF; core.autocrlf on Windows checkouts).
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
