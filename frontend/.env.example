# Copy to .env.local (git-ignored). The MapTiler key ends up in the public bundle, which is normal
# for map keys: restrict it to arthistory.piogino.ch and localhost in the MapTiler dashboard.
# Without a key the map falls back to OpenFreeMap tiles (free, no key).
VITE_MAPTILER_KEY=

# Development only: where the dev server's /v1 proxy (and so `npm test`) sends API requests.
# Default: the live API. The backend's dev server (cd backend && npm run dev, DB arthistory_dev):
# API_TARGET=http://localhost:3005
