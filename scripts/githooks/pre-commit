#!/bin/bash
# Blocks commits that would leak secrets into this PUBLIC repo.
# Bypass (only if you are sure): git commit --no-verify
staged=$(git diff --cached --name-only --diff-filter=ACM)
fail=0
for f in $staged; do
  case "$(basename "$f")" in
    .env.example) ;;
    .env|.env.*|*.pem|*.key|id_rsa*|id_ed25519*) echo "✗ refusing to commit secret file: $f"; fail=1 ;;
  esac
done
if git diff --cached -U0 --diff-filter=ACM -- . ':!*.example' ':!scripts/githooks/*' \
   | grep -E '^\+' | grep -iqE '(password|passwd|secret|api_key|apikey|token)\s*[=:]\s*["'"'"']?[A-Za-z0-9/+_\-]{8,}|-----BEGIN [A-Z ]*PRIVATE KEY'; then
  echo "✗ staged changes look like they contain a credential. Review with: git diff --cached"
  fail=1
fi
exit $fail
